---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada | XPRO" description="A página que você procura não existe ou mudou de endereço." noindex>
  <section class="pagina-topo" style="min-height:60vh;display:grid;align-content:center">
    <div class="wrap">
      <p class="pagina-rot">Erro 404 · ponto não localizado</p>
      <h1>Esta página saiu do mapa.</h1>
      <p class="pagina-sub">O endereço pode ter mudado. Volte ao início ou veja os serviços.</p>
      <div class="hero-acoes">
        <a href="/servicos/" class="btn btn-amarelo">Ver serviços</a>
        <a href="/" class="btn btn-linha">Início</a>
      </div>
    </div>
  </section>
</Base>
