---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CabecalhoPagina from '../../components/CabecalhoPagina.astro';
import ChamadaWhatsApp from '../../components/ChamadaWhatsApp.astro';
import CardObra from '../../components/CardObra.astro';
import { breadcrumb } from '../../data/schema';

const obras = (await getCollection('obras')).sort((a, b) => a.data.ordem - b.data.ordem);
const trilha = [{ nome: 'Obras', href: '/obras/' }];
---
<Base
  title="Obras de Topografia e Projetos no Sul de Minas | XPRO"
  description="Obras entregues pela XPRO em Varginha e no Sul de Minas: levantamentos, georreferenciamento, loteamentos e usinas solares, com local, serviço e entregáveis."
  schemas={[breadcrumb(trilha)]}
>
  <CabecalhoPagina
    rotulo="Portfólio"
    titulo="Obras entregues"
    subtitulo="Cada obra com local, serviço, o problema do cliente, o que fizemos e o que foi entregue."
    trilha={trilha}
  />

  <section class="secao">
    <div class="wrap">
      <div class="obras">
        {obras.map((o, i) => <CardObra obra={o} indice={i + 1} />)}
      </div>
    </div>
  </section>

  <ChamadaWhatsApp titulo="Tem uma obra parecida?" texto="Mande a localização e o tipo de obra. Dizemos o que é preciso medir e projetar." />
</Base>
