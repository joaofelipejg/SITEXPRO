---
// Formulário de orçamento: monta o pedido e abre o programa de e-mail de quem preenche, já endereçado
// à XPRO (mailto). Não depende de servidor nem de serviço externo. Se o e-mail não abrir, o aviso mostra
// o endereço para copiar e o link do WhatsApp. O WhatsApp também fica no botão flutuante.
import { getCollection } from 'astro:content';
import { empresa } from '../data/empresa';

interface Props {
  claro?: boolean;   // true = versão para fundo branco
}

const { claro = false } = Astro.props;
const servicos = (await getCollection('servicos')).sort((a, b) => a.data.ordem - b.data.ordem);
const grupos = [
  { nome: 'Topografia', itens: servicos.filter((s) => s.data.grupo === 'topografia') },
  { nome: 'Projetos', itens: servicos.filter((s) => s.data.grupo === 'projetos') },
];
// Prefixo dos ids, para cada <label for> apontar para o seu campo
const p = claro ? 'contato' : 'orcamento';
// Na versão clara todos os campos têm exemplo; na escura, só os que já tinham
const exemplo = (texto: string) => (claro ? texto : undefined);
---
<form class:list={['form', 'form-orcamento', { 'form-claro': claro }]} data-email={empresa.email} data-numero={empresa.whatsapp}>
  <div class="campo">
    <label for={`${p}-nome`}>Nome</label>
    <input id={`${p}-nome`} name="nome" required autocomplete="name" placeholder={exemplo('Maria da Silva')}>
  </div>
  <div class="campo">
    <label for={`${p}-telefone`}>Telefone / WhatsApp</label>
    <input id={`${p}-telefone`} name="telefone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="(35) 9 0000-0000">
  </div>
  <div class="campo">
    <label for={`${p}-cidade`}>Cidade do imóvel</label>
    <input id={`${p}-cidade`} name="cidade" required autocomplete="address-level2" placeholder={exemplo('Varginha')}>
  </div>
  <div class="campo">
    <label for={`${p}-servico`}>Tipo de serviço</label>
    <select id={`${p}-servico`} name="servico" required>
      <option value="">Selecione</option>
      {grupos.map((g) => (
        <optgroup label={g.nome}>
          {g.itens.map((s) => <option>{s.data.titulo}</option>)}
        </optgroup>
      ))}
      <option>Não sei qual serviço preciso</option>
    </select>
  </div>
  <div class="campo campo-largo">
    <label for={`${p}-mensagem`}>Mensagem</label>
    <!-- limite: links de e-mail muito longos podem não abrir em alguns programas -->
    <textarea id={`${p}-mensagem`} name="mensagem" rows="3" maxlength="800" placeholder="Área aproximada, localização, para que precisa e prazo desejado."></textarea>
  </div>
  <div class="form-pe">
    <button type="submit" class="btn-orcamento">Enviar por e-mail <span class="seta" aria-hidden="true">→</span></button>
    <small>Abre o seu e-mail com o pedido pronto, endereçado à XPRO. É só confirmar o envio.</small>
    <p class="form-status" role="status" aria-live="polite" hidden></p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('.form-orcamento').forEach((form) => {
    const status = form.querySelector<HTMLParagraphElement>('.form-status')!;
    const email = form.dataset.email ?? '';
    const whatsapp = `https://wa.me/${form.dataset.numero}`;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const valor = (campo: string) => String(d.get(campo) ?? '').trim();
      const assunto = `Pedido de orçamento: ${valor('servico')} · ${valor('cidade')}`;
      const corpo = [
        `Nome: ${valor('nome')}`,
        `Telefone / WhatsApp: ${valor('telefone')}`,
        `Cidade do imóvel: ${valor('cidade')}`,
        `Tipo de serviço: ${valor('servico')}`,
        '',
        valor('mensagem') || '(sem mensagem)',
        '',
        '— Enviado pelo formulário do site da XPRO',
      ].join('\r\n');

      window.location.href = `mailto:${email}?subject=${encodeURIComponent(assunto)}&body=${encodeURIComponent(corpo)}`;

      // o site não tem como saber se o e-mail abriu: deixa o caminho alternativo à mão
      status.hidden = false;
      status.innerHTML =
        `Abrimos o seu e-mail com o pedido pronto. Se ele não abriu, escreva para <strong>${email}</strong>` +
        ` <button type="button" data-copiar>copiar</button> ou fale pelo <a href="${whatsapp}" target="_blank" rel="noopener">WhatsApp</a>.`;
      status.querySelector<HTMLButtonElement>('[data-copiar]')?.addEventListener('click', async (ev) => {
        const botao = ev.currentTarget as HTMLButtonElement;
        try {
          await navigator.clipboard.writeText(email);
          botao.textContent = 'copiado';
        } catch {
          botao.textContent = 'não deu para copiar';
        }
      });
    });
  });
</script>
