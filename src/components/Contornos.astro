---
// Fundo de curvas de nível gerado no build (sem imagem, sem biblioteca).
// animar=true: as curvas se desenham uma vez ao carregar a página.
import { gerarContornos } from '../lib/contornos';

interface Props {
  largura?: number;
  altura?: number;
  semente?: number;
  animar?: boolean;
  class?: string;
}

const { largura = 1600, altura = 900, semente = 11, animar = false, class: classe = '' } = Astro.props;
const curvas = gerarContornos({ largura, altura, semente, passo: 10, niveis: 34 });

// Cotas: cada valor fica uma vez num SVG oculto (display: none) e é repetido com <use>. Assim os números
// aparecem na tela, mas não entram no texto extraído da página (o SVG é só decorativo).
const rotulos = curvas.filter((c) => c.rotulo);
const valores = [...new Set(rotulos.map((c) => c.cota))];
const idCota = (v: number) => `cota-${semente}-${v}`;
---
{/* Modelos das cotas num SVG oculto (display: none): fora do texto extraído da página */}
<svg class="contornos-modelos" style="display:none" aria-hidden="true" focusable="false">
  {valores.map((v) => <text id={idCota(v)}>{v}</text>)}
</svg>
<svg
  class:list={['contornos', classe, { animar }]}
  viewBox={`0 0 ${largura} ${altura}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {curvas.map((c) => (
    <path
      d={c.d}
      class:list={['curva', { mestra: c.mestra }]}
      style={`--n:${c.nivel}`}
    />
  ))}
  {rotulos.map((c) => (
    <use
      href={`#${idCota(c.cota)}`}
      class="cota"
      x={c.rotulo!.x.toFixed(1)}
      y={c.rotulo!.y.toFixed(1)}
      transform={`rotate(${c.rotulo!.angulo.toFixed(1)} ${c.rotulo!.x.toFixed(1)} ${c.rotulo!.y.toFixed(1)})`}
      style={`--n:${c.nivel}`}
    />
  ))}
</svg>
{animar && (
  <script is:inline>
    // Mede o comprimento real de cada curva (getTotalLength) para o traço da animação.
    // Com vector-effect: non-scaling-stroke o tracejado segue a escala da tela, então o
    // valor é multiplicado pela escala (mín. 1) com folga. Sem este script, as curvas
    // aparecem completas, sem animação.
    (function () {
      var svg = document.currentScript && document.currentScript.previousElementSibling;
      if (!svg || !svg.classList.contains('contornos')) return;
      var ctm = svg.getScreenCTM();
      var k = Math.max(1, ctm ? ctm.a : 1) * 1.05;
      svg.querySelectorAll('.curva').forEach(function (p) {
        p.style.setProperty('--L', (p.getTotalLength() * k + 4).toFixed(1));
      });
      svg.classList.add('medido');
    })();
  </script>
)}
