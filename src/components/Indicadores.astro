---
// Faixa de indicadores (usada na home e na página Sobre). O rótulo numerado é o h2 da seção.
import SecaoCab from './SecaoCab.astro';
import { empresa } from '../data/empresa';

interface Props {
  /** número da seção na página (selo) */
  num?: string;
}
const { num } = Astro.props;

// Indicadores do portfólio da XPRO
const indicadores = [
  { valor: '+100', rotulo: 'Projetos entregues', desc: 'Para indústrias, incorporadoras, varejo e produtores rurais.' },
  { valor: '+500', rotulo: 'Hectares levantados', desc: 'Medidos com GNSS RTK e drone, de lotes urbanos a fazendas.' },
  { valor: '+50', rotulo: 'Imóveis certificados no SIGEF', desc: `Georreferenciamento de imóveis rurais certificado no INCRA. Credenciado ${empresa.responsavelTecnico.incra.codigo}.` },
];
---
<section class="secao secao-azul secao-indicadores" aria-labelledby="indicadores-titulo">
  <div class="wrap">
    <div class="ind-faixa">
      <SecaoCab num={num} rotulo="Indicadores" id="indicadores-titulo" />
      <ul class="indicadores">
        {indicadores.map((i) => (
          <li class="indicador">
            <span class="ind-valor">{i.valor}</span>
            <span class="ind-rotulo">{i.rotulo}</span>
            <p class="ind-desc">{i.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
