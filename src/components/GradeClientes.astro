---
// Grade de clientes (usada na home e na página Sobre). Só a grade: cada página põe o seu título.
// Para colocar o logo: salve o arquivo em src/assets/clientes/, importe aqui
// (ex.: import logoCimed from '../assets/clientes/cimed.png';) e preencha "logo".
// Sem logo, a célula mostra o nome do cliente em texto.
import { Image } from 'astro:assets';

// obra (opcional): página da obra feita para o cliente; o nome vira link para ela.
const clientes: { nome: string; segmento: string; logo?: ImageMetadata; obra?: string }[] = [
  { nome: 'Cimed', segmento: 'Indústria farmacêutica', obra: '/obras/cimed-pouso-alegre/' },
  { nome: 'Grupo Boticário', segmento: 'Logística' },
  { nome: 'Nutrien', segmento: 'Soluções agrícolas', obra: '/obras/nutrien-fama/' },
  { nome: 'Andrade FS Incorporadora', segmento: 'Incorporação', obra: '/obras/andrade-mundo-novo-varginha/' },
  { nome: 'Supermercados Alvorada', segmento: 'Varejo', obra: '/obras/supermercado-alvorada-varginha/' },
  { nome: 'Fortgreen', segmento: 'Agronegócio' },
];
---
<ul class="clientes">
  {clientes.map((c) => (
    <li class="cliente">
      <div class="cliente-logo">
        {c.logo
          ? <Image src={c.logo} alt={c.nome} height={96} />
          : c.obra
            ? <a class="cliente-nome cliente-link" href={c.obra}>{c.nome}</a>
            : <span class="cliente-nome">{c.nome}</span>}
      </div>
      <span class="cliente-seg">{c.segmento}</span>
    </li>
  ))}
</ul>
