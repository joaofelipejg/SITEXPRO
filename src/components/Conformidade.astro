---
// Bloco "Conformidade e segurança" da home: norma, NRs e regularização do drone.
// Dados em src/data/autoridade.ts; o que estiver sem dado (null) não aparece.
// Ícones genéricos desenhados aqui (sem logos oficiais da ABNT, ANAC ou DECEA).
import SecaoCab from './SecaoCab.astro';
import { autoridade, listaNrs } from '../data/autoridade';

const { norma, drone } = autoridade;

const cards = [
  { icone: 'norma', titulo: norma.codigo, linha: norma.descricao },
  { icone: 'capacete', titulo: `NRs ${listaNrs.replace(/NR-/g, '')}`, linha: 'Equipe treinada para obra e indústria' },
  drone.cadastroAnac && {
    icone: 'drone',
    titulo: 'ANAC',
    linha: drone.pilotoCertificado ? 'Drone cadastrado e piloto certificado' : 'Drone cadastrado no SISANT',
  },
  drone.voosDecea && { icone: 'aviao', titulo: 'DECEA', linha: 'Voos autorizados no espaço aéreo' },
].filter(Boolean) as { icone: string; titulo: string; linha: string }[];
---
<section class="secao secao-azul" id="conformidade" aria-labelledby="conformidade-titulo">
  <div class="wrap">
    <SecaoCab rotulo="Normas e segurança" titulo="Conformidade técnica e segurança em campo" id="conformidade-titulo">
      <p>Trabalhamos dentro das normas que construtoras, indústrias e cartórios exigem. Nossa equipe entra em obra e em área industrial com a documentação de segurança em dia.</p>
    </SecaoCab>
    <ul class="conformidade">
      {cards.map((c) => (
        <li class="conformidade-item">
          <svg class="conformidade-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {c.icone === 'norma' && (
              <>
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                <path d="M14 3v5h5" />
                <path d="m9 14 2 2 4-4" />
              </>
            )}
            {c.icone === 'capacete' && (
              <>
                <path d="M3 17h18" />
                <path d="M5 17v-3a7 7 0 0 1 14 0v3" />
                <path d="M10 7.3V5h4v2.3" />
                <path d="M12 7v5" />
              </>
            )}
            {c.icone === 'drone' && (
              <>
                <rect x="9" y="10" width="6" height="4" rx="1" />
                <path d="M9 11 5.5 7.5M15 11l3.5-3.5M9 13l-3.5 3.5M15 13l3.5 3.5" />
                <path d="M3 7.5h5M16 7.5h5M3 16.5h5M16 16.5h5" />
              </>
            )}
            {c.icone === 'aviao' && (
              <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z" />
            )}
          </svg>
          <h3>{c.titulo}</h3>
          <p>{c.linha}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
